<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- GameFrameX 2.0 包还原源（内部验证期）：
             相对路径按「生成工程所在目录」解析，即 LocalPackages 必须位于生成工程目录的父目录下
             （GameFrameX 源码仓 `dotnet pack` 产物投放目录，与生成工程同级摆放）；缺失或摆放不符将还原失败 NU1301。
             GameFrameX 2.0 公开发布至 nuget.org 后：删除下面的 GameFrameX-Internal 源即可（2.0.0 当前不在 nuget.org）。 -->
        <add key="GameFrameX-Internal" value="../LocalPackages" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
