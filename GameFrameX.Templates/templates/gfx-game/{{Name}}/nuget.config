<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <!-- GameFrameX 2.0 包尚未发布到 nuget.org：本源为内部验证 feed，按「生成工程的同级目录」解析
             （即需与 LocalPackages 同层摆放生成位置，否则 dotnet restore 以 NU1301 失败）。
             公开发布后：删除本源改用 nuget.org；在此之前也可把 value 改为你自己的 feed 路径。 -->
        <add key="GameFrameX-Internal" value="../LocalPackages" />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>
