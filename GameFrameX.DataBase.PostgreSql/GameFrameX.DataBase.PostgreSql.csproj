<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Version.props" Label="版本号定义"/>
    <PropertyGroup>
        <Description>GameFrameX.DataBase.PostgreSql,GameFrameX 框架的 PostgreSQL 数据访问实现模块. PostgreSQL data access implementation module for the GameFrameX framework. Documentation: https://gameframex.doc.alianblank.com</Description>
        <PackageTags>GameFrameX,DataBase,Database,PostgreSql,PostgreSQL,Persistence,Repository,Server,GameServer</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.DataBase\GameFrameX.DataBase.csproj"/>
        <ProjectReference Include="..\GameFrameX.Localization\GameFrameX.Localization.csproj"/>
        <ProjectReference Include="..\GameFrameX.Utility\GameFrameX.Utility.csproj"/>
    </ItemGroup>

    <!-- C166 依赖方向裁定（第二轮）：本程序集不引用 GameFrameX.NetWork.RemoteMessaging——共享发现/玩家路由契约
         已下沉至 GameFrameX.DataBase（命名空间保留，经既有 DataBase 引用解析）；路由胶水装配由组合侧
         DiscoveryRoutingWire（RemoteMessaging）承担，Runtime 暴露 IRoleRouteTableProvider 供其装配。 -->
    <!-- C166：发现层 Runtime.ResetForTest / SimulateActivatedForTest 等 internal 测试缝随实现迁入，IVT 自 RemoteMessaging 同步迁移。 -->
    <ItemGroup>
<InternalsVisibleTo Include="GameFrameX.Tests, "/>
    </ItemGroup>

    <ItemGroup>
        <!-- C168 依赖政策例外（D9）：仅本模块允许 EF Core 全家（经 Npgsql provider 传递）；DataBase / Mongo
             依赖面零变化。版本依据：EF Core 10 线 Npgsql provider 10.0.3（计划期实测 owned JSON 离线翻译可用）。
             EFCore.BulkExtensions 曾按 D3 引入，实测不支持 owned JSON 列（COPY 视 Doc 为物理列，42703），
             已回退为分批 tracked SaveChanges 并移除依赖（见 notes.md P0-① 结论）。 -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
    </ItemGroup>

</Project>
