<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- 签名以获得强名称库的 InternalsVisibleTo 友元访问（公共签名：仅嵌入公钥） -->
        <PublicSign>true</PublicSign>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../gameframex.key.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.assert" Version="2.9.3" />
        <PackageReference Include="xunit.core" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- CI 门禁用：为 vstest 提供 github logger（logger 参数 github;summary=true），本地无 GITHUB_ACTIONS 环境时自动降级为普通输出 -->
        <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\GameFrameX.Apps\GameFrameX.Apps.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Core\GameFrameX.Core.csproj" />
      <ProjectReference Include="..\..\GameFrameX.DataBase\GameFrameX.DataBase.csproj" />
      <ProjectReference Include="..\..\GameFrameX.DataBase.Mongo\GameFrameX.DataBase.Mongo.csproj" />
      <ProjectReference Include="..\..\GameFrameX.ProtoBuf.Net\GameFrameX.ProtoBuf.Net.csproj" />
      <ProjectReference Include="..\..\GameFrameX.StartUp\GameFrameX.StartUp.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Utility\GameFrameX.Utility.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Hotfix\GameFrameX.Hotfix.csproj" />
      <ProjectReference Include="..\..\GameFrameX.NetWork\GameFrameX.NetWork.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Online\GameFrameX.Online.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Online.Runtime\GameFrameX.Online.Runtime.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Architecture.Analyzers\GameFrameX.Architecture.Analyzers.csproj" />
    </ItemGroup>

</Project>
