<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- 签名以获得强名称库的 InternalsVisibleTo 友元访问（公共签名：仅嵌入公钥） -->
        <PublicSign>true</PublicSign>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../gameframex.key.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.assert" Version="2.9.3" />
        <PackageReference Include="xunit.core" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- CI 门禁用：为 vstest 提供 github logger（logger 参数 github;summary=true），本地无 GITHUB_ACTIONS 环境时自动降级为普通输出 -->
        <PackageReference Include="GitHubActionsTestLogger" Version="3.0.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- 限制测试并行线程数：真实 socket 的测试族（SuperSocket TCP/KCP）在 12 核满载并行下，
             连接拆除与收包循环的竞态窗口会被 CPU 争用放大（包内 ReadPipeAsync 续体逃逸致 test host 崩溃）；
             并行度收敛到 2 后满载崩溃不再复现，吞吐代价可接受（见 C207 验证记录） -->
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\GameFrameX.Apps\GameFrameX.Apps.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Core\GameFrameX.Core.csproj" />
      <ProjectReference Include="..\..\GameFrameX.DataBase\GameFrameX.DataBase.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Discovery\GameFrameX.Discovery.csproj" />
      <ProjectReference Include="..\..\GameFrameX.DataBase.Mongo\GameFrameX.DataBase.Mongo.csproj" />
      <ProjectReference Include="..\..\GameFrameX.DataBase.PostgreSql\GameFrameX.DataBase.PostgreSql.csproj" />
      <ProjectReference Include="..\..\GameFrameX.DataBase.Sqlite\GameFrameX.DataBase.Sqlite.csproj" />
      <ProjectReference Include="..\..\GameFrameX.ProtoBuf.Net\GameFrameX.ProtoBuf.Net.csproj" />
      <ProjectReference Include="..\..\GameFrameX.StartUp\GameFrameX.StartUp.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Utility\GameFrameX.Utility.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Hotfix\GameFrameX.Hotfix.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Network\GameFrameX.Network.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Launcher\GameFrameX.Launcher.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Hosting.Abstractions\GameFrameX.Capability.Hosting.Abstractions.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Hosting.Core\GameFrameX.Capability.Hosting.Core.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Hosting.AdminApi\GameFrameX.Capability.Hosting.AdminApi.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Abstractions\GameFrameX.Capability.Online.Abstractions.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Foundation\GameFrameX.Capability.Online.Foundation.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Assets\GameFrameX.Capability.Online.Assets.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Social\GameFrameX.Capability.Online.Social.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Matchmaking\GameFrameX.Capability.Online.Matchmaking.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Match\GameFrameX.Capability.Online.Match.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Competition\GameFrameX.Capability.Online.Competition.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Operations\GameFrameX.Capability.Online.Operations.csproj" />
      <ProjectReference Include="..\..\Capability\GameFrameX.Capability.Online.Persistence\GameFrameX.Capability.Online.Persistence.csproj" />
      <ProjectReference Include="..\..\GameFrameX.Architecture.Analyzers\GameFrameX.Architecture.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
      <ProjectReference Include="..\..\GameFrameX.Client\GameFrameX.Client.csproj" />
    </ItemGroup>

    <!-- 机制层测试族发现面（C294）：把测试程序集复制为部署命名约定形态
         GameFrameX.Tests.CapabilityStubs.dll —— 机制按 {前缀}.*.dll 圈定扫描面后按程序集标识
         解析回本测试程序集，使测试桩能力模块可经 Compose 真实装配路径被发现。 -->
    <Target Name="CopyTestAssemblyAsCapabilityStubs" AfterTargets="Build">
      <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OutDir)GameFrameX.Tests.CapabilityStubs.dll" SkipUnchangedFiles="true" />
    </Target>

</Project>
