<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../Version.props" Label="版本号定义"/>

    <PropertyGroup>
        <Description>GameFrameX.Capability.Online.Social,GFX Online 社交能力包:好友/群组/聊天/通知/处罚/举报裁决六域 + 聊天审计投影(InMemory 默认存储,描述符服务面 Override 替换)+ admin handlers(kick/revoke/mute/查询族). Social capability package for the GFX Online family: friends, groups, chat, notifications, punishments and report adjudication plus the chat-audit projection with in-memory default stores and admin handlers. Documentation: https://gameframex.doc.alianblank.com</Description>
        <PackageTags>GameFrameX,Capability,Online,Social,Friend,Chat,Punishment,GameServer</PackageTags>
        <!-- 本包语言版本随 Directory.Build.props（latest），语法风格仍按仓内 C#10 惯例书写
             （无 switch 表达式 / record / 顶层语句）。 -->
    </PropertyGroup>

    <ItemGroup>
        <!-- admin handler 载荷序列化（此前经 DataBase/Apps 传递获得；引用拆除后显式直引） -->
        <PackageReference Include="GameFrameX.Foundation.Json" Version="5.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../GameFrameX.Capability.Online.Abstractions/GameFrameX.Capability.Online.Abstractions.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Online.Foundation/GameFrameX.Capability.Online.Foundation.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Hosting.Core/GameFrameX.Capability.Hosting.Core.csproj"/>
    </ItemGroup>

</Project>
