<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../Version.props" Label="版本号定义"/>

    <PropertyGroup>
        <Description>GameFrameX.Capability.Online.Persistence,GFX Online 分级持久化适配包:Identity/PlayerStorage/资产账本三域一级 store 的 GameDb 适配(物化复合键唯一索引 + 条件写原语 + 序列接管),Session/Presence 保持易失;组合根经 UseOnlineGameDbStores 预置替换缝,InMemory 默认不变. Graded-persistence adapter package for the GFX Online family: GameDb adapters for the three level-one stores (identity, player storage and the asset ledger) built on materialized composite-key unique indexes, the conditional-write primitives and sequence take-over, while sessions and presence stay volatile; composition roots pre-seed the replacement seam via UseOnlineGameDbStores and the in-memory default is unchanged. Documentation: https://gameframex.doc.alianblank.com</Description>
        <PackageTags>GameFrameX,Capability,Online,Persistence,GameDb,SQLite,Mongo,PostgreSql,GameServer</PackageTags>
        <LangVersion>10</LangVersion>
        <!-- 能力域持久化行属于本包；接入分析器时不套用旧 Apps 状态归属规则。
             仅关闭本工程的 GFX0001；注册/依赖规则及其它架构诊断继续生效。 -->
        <NoWarn>$(NoWarn);GFX0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../GameFrameX.Capability.Online.Abstractions/GameFrameX.Capability.Online.Abstractions.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Online.Foundation/GameFrameX.Capability.Online.Foundation.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Online.Assets/GameFrameX.Capability.Online.Assets.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Online.Social/GameFrameX.Capability.Online.Social.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Hosting.Core/GameFrameX.Capability.Hosting.Core.csproj"/>
        <ProjectReference Include="../../GameFrameX.DataBase/GameFrameX.DataBase.csproj"/>
    </ItemGroup>

</Project>
