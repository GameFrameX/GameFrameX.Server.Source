        <ProjectReference Include="../../GameFrameX.Proto/GameFrameX.Proto.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Online.Matchmaking/GameFrameX.Capability.Online.Matchmaking.csproj"/>
        <ProjectReference Include="../GameFrameX.Capability.Hosting.Core/GameFrameX.Capability.Hosting.Core.csproj"/>
