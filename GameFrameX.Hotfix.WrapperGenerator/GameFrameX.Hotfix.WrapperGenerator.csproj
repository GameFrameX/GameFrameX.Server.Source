<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Version.props" Label="版本号定义"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <!-- RS2008（analyzer release tracking）：与分析器项目同约定不启用 release tracking，诊断 ID 变更走 CHANGELOG 披露 -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
        <Description>GameFrameX.Hotfix.WrapperGenerator,GameFrameX 框架的 Hotfix Wrapper Roslyn 源码生成器模块. Hotfix Wrapper Roslyn source generator module for the GameFrameX framework. Documentation: https://gameframex.doc.alianblank.com</Description>
        <PackageTags>GameFrameX,Hotfix,WrapperGenerator,SourceGenerator,Roslyn,Analyzer,Server,GameServer</PackageTags>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- C292：对齐 global.json 基线（10.0.100 ⇒ Roslyn 5.0.0，与 Architecture.Analyzers 同一约定）；
             引用更新的 Roslyn 会在较老 SDK 下触发 CS9057 且生成器静默不加载（C291 期间即处于此状态，
             代理未串行化）。生成器已按 C292 支持同名代理（命名空间镜像 + hintName 唯一）。 -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
        <None Include="$(OutputPath)\$(AssemblyName).pdb"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

</Project>
