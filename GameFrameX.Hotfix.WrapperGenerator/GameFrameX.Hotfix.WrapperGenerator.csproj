<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../Version.props" Label="版本号定义"/>

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Description>GameFrameX.Hotfix.WrapperGenerator,GameFrameX 框架的 Hotfix Wrapper Roslyn 源码生成器模块. Hotfix Wrapper Roslyn source generator module for the GameFrameX framework. Documentation: https://gameframex.doc.alianblank.com</Description>
        <PackageTags>GameFrameX,Hotfix,WrapperGenerator,SourceGenerator,Roslyn,Analyzer,Server,GameServer</PackageTags>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- 维持 5.9.0。降到 SDK 编译器版本（5.3.0）会让生成器真正加载并因同名代理
             （Player/Login 与 ServerRole/Login 各一个 LoginComponentAgent）hintName 冲突崩溃（CS8785），
             且恢复生成器等于恢复 Actor 串行化，属行为变更。 -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
        <None Include="$(OutputPath)\$(AssemblyName).pdb"
              Pack="true"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

</Project>
