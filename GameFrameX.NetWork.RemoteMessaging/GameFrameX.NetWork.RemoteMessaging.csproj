<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../Version.props" Label="版本号定义"/>

    <PropertyGroup>
        <Description>GameFrameX.NetWork.RemoteMessaging,GameFrameX 框架的远程消息治理与调用编排模块. Remote messaging governance and call orchestration module for the GameFrameX framework. Documentation: https://gameframex.doc.alianblank.com</Description>
        <PackageTags>GameFrameX,NetWork,RemoteMessaging,Messaging,RPC,Orchestration,Server,GameServer</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.NetWork\GameFrameX.NetWork.csproj"/>
        <ProjectReference Include="..\GameFrameX.NetWork.Message\GameFrameX.NetWork.Message.csproj"/>
        <ProjectReference Include="..\GameFrameX.ProtoBuf.Net\GameFrameX.ProtoBuf.Net.csproj"/>
        <ProjectReference Include="..\GameFrameX.Utility\GameFrameX.Utility.csproj"/>
    </ItemGroup>
    <!-- C166 依赖方向裁定（第二轮）：共享发现/玩家路由契约已下沉至 GameFrameX.DataBase（命名空间保留），
         本程序集仅引用 DataBase 抽象层获取契约；路由胶水（RoleRouterHolder/InProcess/TcpForwarder）留在本程序集，
         由 DiscoveryRoutingWire 在组合侧装配。 -->
    <ItemGroup>
        <ProjectReference Include="..\GameFrameX.DataBase\GameFrameX.DataBase.csproj"/>
    </ItemGroup>

    <!-- C166 依赖方向裁定（用户决策）：本程序集禁止引用数据库实现程序集（GameFrameX.DataBase.Mongo / GameFrameX.DataBase.PostgreSql），
         也不直接引用驱动包；发现层的驱动相关实现（*EndpointRegistry / *EndpointWatcher / *DiscoveryRuntime / *PlayerRoute*）
         已下沉至对应数据库实现程序集（实现程序集反向引用本程序集复用路由契约与转发胶水，无环）。
         本程序集只保留驱动无关的发现契约、路由表、环境引导（AdvertiseEndpointEnvironment）与消息胶水。 -->

    <!-- C152/C166：internal 测试缝给测试工程（DiscoveryRoutingWire.ResetForTest / SimulateInitializedForTest 等），
         先例同 DataBase / StartUp / Utility；发现层 Runtime 侧测试缝随实现下沉至数据库实现程序集。 -->
    <ItemGroup>
        <InternalsVisibleTo Include="GameFrameX.Tests, "/>
    </ItemGroup>
</Project>
